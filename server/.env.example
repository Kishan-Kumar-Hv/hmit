PORT=5000

# Local PostgreSQL connection or Supabase DATABASE_URL
# Option A: Full Supabase / Cloud connection string (recommended for Supabase)
# DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Option B: Individual PostgreSQL parameters
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change-me
PG_DATABASE=postgres
PG_SSL=false


# Generate each value as a separate base64-encoded random 32-byte key.
JWT_SECRET=replace-with-a-private-random-secret-at-least-32-bytes
FACE_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

FACE_SERVICE_URL=http://127.0.0.1:8001
STEGANOGRAPHY_SERVICE_URL=http://127.0.0.1:8001
